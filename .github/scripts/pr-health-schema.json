{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two or three sentences on what the PR does and its overall state."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "dimension",
          "file",
          "line",
          "end_line",
          "title",
          "detail",
          "suggestion"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "dimension": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "maintainability",
              "testing"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "description": "First affected line in the new file, or 0 if not line-specific."
          },
          "end_line": {
            "type": "integer",
            "description": "Last affected line in the new file; the same as line for a single line."
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "description": "What goes wrong, under what input or state, and the fix."
          },
          "suggestion": {
            "type": "string",
            "description": "Exact replacement text for lines line through end_line, keeping their indentation, or an empty string when the fix is not a local edit."
          }
        }
      }
    }
  }
}
