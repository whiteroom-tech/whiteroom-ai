NEXT_PUBLIC_PROXY_URL=http://localhost:8080

# Google OAuth client (Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret
# openssl rand -base64 32
AUTH_SECRET=your-random-secret

# Local dev: run `cloud-sql-proxy whiteroom-prod:us-central1:whiteroom-tech-v1 --port 5433`
# then connect through it. DB_SOCKET_PATH is set only in the Cloud Run environment.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=whiteroom_dashboard_app
DB_PASSWORD=your-db-password
DB_NAME=whiteroom_dashboard
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM=WhiteRoom <no-reply@whiteroom.tech>

# Stripe. Test keys locally; the webhook secret is per-endpoint, so the value
# from `stripe listen` is NOT the one the deployed endpoint uses.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# Shared with the engine (Fly secret of the same name). Without it the
# dashboard skips the entitlement push and logs a warning; fleets then stay on
# whatever the engine already had for them.
WR_ENTITLEMENT_SYNC_SECRET=shared-secret-with-the-engine

# Absolute origin used in outgoing email links and Stripe return URLs. Derived
# from X-Forwarded-* headers when unset, which is right on Cloud Run.
# AUTH_URL=https://app.whiteroom.tech

# Hostname that serves the admin panel, e.g. admin.whiteroom.tech. When set,
# /admin serves ONLY on that host and 404s everywhere else (see src/proxy.ts).
# Leave unset for single-host local dev, or set admin.localhost:3000 to
# exercise the split locally — browsers resolve *.localhost to 127.0.0.1.
#
# Sessions are host-only cookies, so an admin signs in on the admin host
# separately from the app. That means AUTH_URL must stay UNSET in a multi-host
# deployment: a fixed value would send every OAuth callback to one host.
# ADMIN_HOST=admin.whiteroom.tech
